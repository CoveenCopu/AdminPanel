@model AdminPanel.Models.Order

@{
    // Titel som vises i browser/tab
    ViewData["Title"] = "Tilføj ordre";

    // Henter produkter fra ViewBag
    var produkter =
        ViewBag.Produkter as List<AdminPanel.Models.Product>
        ?? new List<AdminPanel.Models.Product>();
}

<!-- Overskrift -->
<h2>Tilføj ordre</h2>

<!-- Formular til oprettelse af ordre -->
<form asp-action="Create" method="post">

    <!-- Fejlbeskeder -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Der opstod en fejl:</strong>
            <div asp-validation-summary="All"></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Kunde -->
    <div class="form-group mb-2">
        <label asp-for="Customer"></label>
        <input asp-for="Customer" class="form-control" />
    </div>

    <!-- By -->
    <div class="form-group mb-2">
        <label asp-for="City"></label>
        <input asp-for="City" class="form-control" />
    </div>

    <!-- Adresse -->
    <div class="form-group mb-2">
        <label asp-for="Address"></label>
        <input asp-for="Address" class="form-control" />
    </div>

    <!-- Telefonnummer -->
    <div class="form-group mb-2">
        <label asp-for="Number"></label>
        <input asp-for="Number" class="form-control" />
    </div>

    <!-- Opsætningsdato -->
    <div class="form-group mb-2">
        <label asp-for="SetupDate"></label>
        <input asp-for="SetupDate"
               type="date"
               id="opsaetningsdato"
               class="form-control" />
    </div>

    <!-- Afhentningsdato -->
    <div class="form-group mb-2">
        <label asp-for="PickupDate"></label>
        <input asp-for="PickupDate"
               type="date"
               id="afhaentningsdato"
               class="form-control" />
    </div>

    <!-- Transport -->
    <div class="form-group mb-2">
        <label asp-for="Transport"></label>
        <input asp-for="Transport" class="form-control" />
    </div>

    <!-- Produktliste -->
    <h4>Produkter</h4>

    <table class="table table-bordered">
        <!-- Tabel overskrifter -->
        <thead>
            <tr>
                <th>Produkt</th>
                <th>Pris</th>
                <th>Antal</th>
            </tr>
        </thead>
        <!-- Tabel data -->
        <tbody>
            <!-- Gennemgår alle produkter -->
            @for (int i = 0; i < produkter.Count; i++)
            {
                int pid = produkter[i].Id;
                <tr>
                    <!-- Produkt navn -->
                    <td>@produkter[i].Name</td>
                    <!-- Produkt pris -->
                    <td>@produkter[i].Price.ToString("C")</td>
                    <!-- Antal input -->
                    <td>
                        <!-- Skjulte product felter -->
                        <input type="hidden" name="products[@i].Id" value="@pid" />
                        <input type="hidden" name="products[@i].Name" value="@produkter[i].Name" />
                        <input type="hidden" name="products[@i].Price" value="@produkter[i].Price" />

                        <!-- Antal input -->
                        <input type="number"
                               name="quantity[@i]"
                               min="0"
                               value="0"
                               class="form-control antal-input"
                               data-prodid="@pid"
                               data-produktnavn="@produkter[i].Name" />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Gem knap -->
    <button type="submit" class="btn btn-primary">
        Gem ordre
    </button>

    <!-- Tilbage/annuller -->
    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>
