@model AdminPanel.Models.Order

<h2>Ordredetaljer</h2>

<div>
    <b>Kunde:</b> @Model.Customer <br />
    <b>Adresse:</b> @Model.Address <br />
    <b>Telefon:</b> @Model.Number <br />
    <b>Opsætning:</b> @Model.SetupDate?.ToShortDateString() <br />
    <b>Afhentning:</b> @(Model.PickupDate?.ToShortDateString() ?? "") <br />
    <b>Transport:</b> @Model.Transport <br />
    <b>Pris:</b> @Model.OrderItems.Sum(oi => (oi.Product?.Price ?? 0) * oi.Quantity).ToString("C") <br />
    <b>Noter:</b> @Model.Notes
</div>

<h4>Produkter</h4>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Produkt</th>
            <th>Pris</th>
            <th>Antal</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderItems)
        {
            <tr>
                <td>@item.Product.Name</td>
                <td>@(item.Product?.Price ?? 0).ToString("C")</td>
                <td>@item.Quantity</td>
                <td>@((item.Product?.Price ?? 0) * item.Quantity).ToString("C")</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Tilbage til Ordrer</a>