@model AdminPanel.Models.Order

@{
    ViewData["Title"] = "Rediger ordre";
    var produkter = ViewBag.Produkter as List<AdminPanel.Models.Product> ?? new List<AdminPanel.Models.Product>();
    var eksisterende = Model.OrderItems.ToDictionary(oi => oi.ProductId, oi => oi.Quantity);
}

<h2>Rediger ordre</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group mb-2">
        <label asp-for="Customer"></label>
        <input asp-for="Customer" class="form-control" />
    </div>
    <div class="form-group mb-2">
        <label asp-for="City"></label>
        <input asp-for="City" class="form-control" />
    </div>
    <div class="form-group mb-2">
        <label asp-for="Address"></label>
        <input asp-for="Address" class="form-control" />
    </div>
    <div class="form-group mb-2">
        <label asp-for="Number"></label>
        <input asp-for="Number" class="form-control" />
    </div>
    <div class="form-group mb-2">
        <label asp-for="SetupDate"></label>
        <input asp-for="SetupDate" type="date" class="form-control" id="opsaetningsdato"
               value="@Model.SetupDate?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="form-group mb-2">
        <label asp-for="PickupDate"></label>
        <input asp-for="PickupDate" type="date" class="form-control" id="afhaentningsdato"
               value="@Model.PickupDate?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="form-group mb-2">
        <label asp-for="Transport"></label>
        <input asp-for="Transport" type="number" step="0.01" class="form-control" />
    </div>

    <h4>Produkter</h4>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Produkt</th>
                <th>Pris</th>
                <th>Tilgængelig</th>
                <th>Antal</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < produkter.Count; i++)
            {
                int pid = produkter[i].Id;
                int antal = eksisterende.ContainsKey(pid) ? eksisterende[pid] : 0;
                <tr>
                    <td>@produkter[i].Name</td>
                    <td>@produkter[i].Price.ToString("C")</td>
                    <td id="tilgaengelig_@pid">0</td>
                    <td>
                        <input type="hidden" name="produktId" value="@pid" />
                        <input type="number" name="antal" min="0" value="@antal"
                               class="form-control antal-input" data-prodid="@pid" data-produktnavn="@produkter[i].Name" />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="form-group mb-2">
        <label asp-for="Notes"></label>
        <input asp-for="Notes" id="noter" class="form-control" readonly value="@Model.Notes" />
    </div>

    <button type="submit" class="btn btn-primary">Gem ændringer</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const opsInput = document.getElementById('opsaetningsdato');
        const afhInput = document.getElementById('afhaentningsdato');
        const antalInputs = document.querySelectorAll('.antal-input');
        const noterInput = document.getElementById('noter');

        async function updateTilgængelighed() {
            const opsDato = opsInput.value;
            const afhDato = afhInput.value;
            if (!opsDato || !afhDato) return;

            try {
                const response = await fetch(`/Orders/Availability?start=${opsDato}&end=${afhDato}`);
                const data = await response.json();

                antalInputs.forEach(input => {
                    const pid = input.dataset.prodid;
                    const td = document.getElementById('tilgaengelig_' + pid);
                    const maxTilg = data[pid] ?? 0;
                    td.innerText = maxTilg;

                    const antal = parseInt(input.value);
                    if (antal > maxTilg) {
                        alert(`Ikke nok af produktet "${input.dataset.produktnavn}": ønsket ${antal}, maks ${maxTilg}`);
                        input.value = maxTilg;
                    }
                    input.max = maxTilg;
                });
            } catch (err) {
                console.error(err);
            }
        }

        function updateAfhentning() {
            const opsDato = new Date(opsInput.value);
            if (!isNaN(opsDato)) {
                const afhDato = new Date(opsDato);
                afhDato.setDate(afhDato.getDate() + 2);
                afhInput.value = afhDato.toISOString().split('T')[0];
                updateTilgængelighed();
            }
        }

        function updateNotes() {
            let notes = [];
            antalInputs.forEach(input => {
                const antal = parseInt(input.value);
                if (antal > 0) notes.push(`${antal} x ${input.dataset.produktnavn}`);
            });
            noterInput.value = notes.join(', ');
        }

        opsInput.addEventListener('change', updateAfhentning);
        antalInputs.forEach(input => {
            input.addEventListener('input', () => {
                updateNotes();
                updateTilgængelighed();
            });
        });

        updateAfhentning();
        updateNotes();
    </script>
}