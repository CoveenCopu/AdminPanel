@model AdminPanel.Models.Order

@{
    // Titel som vises i browser/tab
    ViewData["Title"] = "Rediger ordre";

    // Henter produkter fra ViewBag
    var produkter =
        ViewBag.Produkter as List<AdminPanel.Models.Product>
        ?? new List<AdminPanel.Models.Product>();

    // Opretter dictionary med eksisterende produkter og antal
    var eksisterende =
        Model.OrderItems.ToDictionary(
            oi => oi.ProductId,
            oi => oi.Quantity
        );
}

<!-- Overskrift -->
<h2>Rediger ordre</h2>

<!-- Formular til redigering -->
<form asp-action="Edit" method="post">

    <!-- Skjult ID -->
    <input type="hidden" asp-for="Id" />

    <!-- Kunde -->
    <div class="form-group mb-2">

        <label asp-for="Customer"></label>

        <input asp-for="Customer"
               class="form-control" />
    </div>

    <!-- By -->
    <div class="form-group mb-2">

        <label asp-for="City"></label>

        <input asp-for="City"
               class="form-control" />
    </div>

    <!-- Adresse -->
    <div class="form-group mb-2">

        <label asp-for="Address"></label>

        <input asp-for="Address"
               class="form-control" />
    </div>

    <!-- Telefonnummer -->
    <div class="form-group mb-2">

        <label asp-for="Number"></label>

        <input asp-for="Number"
               class="form-control" />
    </div>

    <!-- Opsætningsdato -->
    <div class="form-group mb-2">

        <label asp-for="SetupDate"></label>

        <input asp-for="SetupDate"
               type="date"
               class="form-control"
               id="opsaetningsdato"
               value="@Model.SetupDate?.ToString("yyyy-MM-dd")" />
    </div>

    <!-- Afhentningsdato -->
    <div class="form-group mb-2">

        <label asp-for="PickupDate"></label>

        <input asp-for="PickupDate"
               type="date"
               class="form-control"
               id="afhaentningsdato"
               value="@Model.PickupDate?.ToString("yyyy-MM-dd")" />
    </div>

    <!-- Transport -->
    <div class="form-group mb-2">

        <label asp-for="Transport"></label>

        <input asp-for="Transport"
               type="number"
               step="0.01"
               class="form-control" />
    </div>

    <!-- Produktliste -->
    <h4>Produkter</h4>

    <table class="table table-bordered">

        <!-- Tabel overskrifter -->
        <thead>
            <tr>
                <th>Produkt</th>
                <th>Pris</th>
                <th>Tilgængelig</th>
                <th>Antal</th>
            </tr>
        </thead>

        <!-- Tabel data -->
        <tbody>

            <!-- Gennemgår alle produkter -->
            @for (int i = 0; i < produkter.Count; i++)
            {
                // Produkt ID
                int pid = produkter[i].Id;

                // Finder eksisterende antal
                int antal =
                eksisterende.ContainsKey(pid)
                ? eksisterende[pid]
                : 0;

                <tr>

                    <!-- Produkt navn -->
                    <td>
                        @produkter[i].Name
                    </td>

                    <!-- Produkt pris -->
                    <td>
                        @produkter[i].Price.ToString("C")
                    </td>

                    <!-- Tilgængeligt lager -->
                    <td id="tilgaengelig_@pid">
                        @produkter[i].Inventory
                    </td>

                    <!-- Antal input -->
                    <td>

                        <!-- Skjult productId -->
                        <input type="hidden"
                               name="productId"
                               value="@pid" />

                        <!-- Antal -->
                        <input type="number"
                               name="quantity"
                               min="0"
                               value="@antal"
                               class="form-control antal-input"
                               data-prodid="@pid"
                               data-produktnavn="@produkter[i].Name" />
                    </td>

                </tr>
            }

        </tbody>
    </table>

    <!-- Noter -->
    <div class="form-group mb-2">

        <label asp-for="Notes"></label>

        <!-- Readonly fordi noter genereres automatisk -->
        <input asp-for="Notes"
               id="noter"
               class="form-control"
               readonly
               value="@Model.Notes" />
    </div>

    <!-- Gem knap -->
    <button type="submit"
            class="btn btn-primary">

        Gem ændringer
    </button>

    <!-- Tilbage/annuller -->
    <a asp-action="Index"
       class="btn btn-secondary">

        Cancel
    </a>

</form>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>


    </script>
}