@model AdminPanel.Models.Expense

@{
    // Titel som vises i browser/tab
    ViewData["Title"] = "Tilføj udgift";
}

<!-- Overskrift -->
<h2>Tilføj Udgift</h2>

<!-- Formular til oprettelse af udgift -->
<form asp-action="Create" method="post">

    <!-- Produkt -->
    <div class="form-group">

        <!-- Label til Product -->
        <label asp-for="Product"></label>

        <!-- Input felt til Product -->
        <input asp-for="Product" class="form-control" />

        <!-- Validation fejl -->
        <span asp-validation-for="Product" class="text-danger"></span>
    </div>

    <!-- Dato -->
    <div class="form-group">

        <!-- Label til Date -->
        <label asp-for="Date"></label>

        <!-- Date input -->
        <input asp-for="Date"
               type="date"
               class="form-control" />

        <!-- Validation fejl -->
        <span asp-validation-for="Date" class="text-danger"></span>
    </div>

    <!-- Antal -->
    <div class="form-group">

        <!-- Label til Quantity -->
        <label asp-for="Quantity"></label>

        <!-- Input felt til Quantity -->
        <input asp-for="Quantity" class="form-control" />

        <!-- Validation fejl -->
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <!-- Pris pr stk -->
    <div class="form-group">

        <!-- Label til PricePerPiece -->
        <label asp-for="PricePerPiece"></label>

        <!-- Input felt til PricePerPiece -->
        <input asp-for="PricePerPiece" class="form-control" />

        <!-- Validation fejl -->
        <span asp-validation-for="PricePerPiece"
              class="text-danger"></span>
    </div>

    <!-- Noter -->
    <div class="form-group">

        <!-- Label til Notes -->
        <label asp-for="Notes"></label>

        <!-- Input felt til Notes -->
        <input asp-for="Notes" class="form-control" />

        <!-- Validation fejl -->
        <span asp-validation-for="Notes"
              class="text-danger"></span>
    </div>

    <!-- Gem knap -->
    <button type="submit"
            class="btn btn-primary">
        Save
    </button>

    <!-- Tilbage/annuller knap -->
    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />
}