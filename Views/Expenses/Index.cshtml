@model IEnumerable<AdminPanel.Models.Expense>

@{
    // Titel som vises i browser/tab
    ViewData["Title"] = "Udgifter";
}

<!-- Overskrift -->
<h2>Udgifter</h2>

<!-- Knap til oprettelse af ny udgift -->
<p>
    <a asp-action="Create"
       class="btn btn-primary">

        Tilføj ny udgift
    </a>
</p>

<!-- Tabel med alle udgifter -->
<table class="table table-striped">

    <!-- Tabel overskrifter -->
    <thead>
        <tr>
            <th>Produkt</th>
            <th>Dato</th>
            <th>Antal</th>
            <th>Pris pr. stk.</th>
            <th>Samlet pris</th>
            <th>Noter</th>
            <th>Handlinger</th>
        </tr>
    </thead>

    <!-- Tabel data -->
    <tbody>

        <!-- Gennemgår alle udgifter -->
        @foreach (var item in Model)
        {
            <tr>

                <!-- Produkt navn -->
                <td>@item.Product</td>

                <!-- Dato -->
                <td>@item.Date.ToShortDateString()</td>

                <!-- Antal -->
                <td>@item.Quantity</td>

                <!-- Pris pr stk -->
                <td>@item.PricePerPiece.ToString("C")</td>

                <!-- Samlet pris -->
                <td>@item.TotalPrice.ToString("C")</td>

                <!-- Noter -->
                <td>@item.Notes</td>

                <!-- Knapper -->
                <td>

                    <!-- Rediger knap -->
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-primary">

                        Edit
                    </a>

                    <!-- Slet knap -->
                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-secondary">

                        Delete
                    </a>

                </td>
            </tr>
        }

    </tbody>
</table>