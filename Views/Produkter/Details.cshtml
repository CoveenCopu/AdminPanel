@model AdminPanel.Models.Product

@{
    ViewData["Title"] = "Produktinfo";
}

<h2>Produktinfo</h2>

<div>
    <h4>@Model.Name</h4>
    <div>Pris: @Model.Price.ToString("C")</div>
    <div>Info: @Model.Info</div>
    <div>Beholdning: @Model.Inventory</div>
</div>

<a asp-action="Index" class="btn btn-secondary">Tilbage</a>