@model AdminPanel.Models.Product
@{
    ViewData["Title"] = "Rediger produkt";
}

<h2>Rediger produkt</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Price"></label>
        <input asp-for="Price" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Inventory"></label>
        <input asp-for="Inventory" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Info"></label>
        <input asp-for="Info" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Gem</button>
    <a asp-action="Index" class="btn btn-secondary">Annuller</a>
</form>