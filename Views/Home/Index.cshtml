@{
    // Titel som vises i browser/tab
    ViewData["Title"] = "MELFAR SERVICEUDLEJNING ADMIN PANEL";
}

<!-- Main container -->
<div class="container mt-5">

    <!-- Overskrift -->
    <h1 class="text-center mb-5"
        style="font-weight: bold; color: #2c3e50;">

        MELFAR SERVICEUDLEJNING ADMIN PANEL
    </h1>

    <!-- Grid række -->
    <div class="row justify-content-center">

        @* Ordrer - både User og Admin *@
        @if (User.IsInRole("User") || User.IsInRole("Admin"))
        {
            <div class="col-md-3 mb-4">

                <!-- Kort -->
                <div class="card text-center shadow-lg h-100 border-primary">

                    <div class="card-body d-flex flex-column justify-content-center">

                        <!-- Ikon -->
                        <i class="bi bi-card-checklist
                                      display-1
                                      text-primary
                                      mb-3"></i>

                        <!-- Titel -->
                        <h3 class="card-title">
                            Ordrer
                        </h3>

                        <!-- Beskrivelse -->
                        <p class="card-text">
                            Se, tilføj og rediger alle ordrer.
                        </p>

                        <!-- Knap -->
                        <a asp-controller="Orders"
                           asp-action="Index"
                           class="btn btn-primary mt-auto">

                            Gå til Ordrer
                        </a>

                    </div>
                </div>
            </div>
        }

        @* Kun Admin *@
        @if (User.IsInRole("Admin"))
        {
            <!-- Udgifter -->
            <div class="col-md-3 mb-4">

                <div class="card text-center shadow-lg h-100 border-success">

                    <div class="card-body d-flex flex-column justify-content-center">

                        <!-- Ikon -->
                        <i class="bi bi-cash-stack
                                      display-1
                                      text-success
                                      mb-3"></i>

                        <!-- Titel -->
                        <h3 class="card-title">
                            Udgifter
                        </h3>

                        <!-- Beskrivelse -->
                        <p class="card-text">
                            Se, tilføj og rediger udgifter.
                        </p>

                        <!-- Knap -->
                        <a asp-controller="Expenses"
                           asp-action="Index"
                           class="btn btn-success mt-auto">

                            Gå til Udgifter
                        </a>

                    </div>
                </div>
            </div>

            <!-- Årsopgørelser -->
            <div class="col-md-3 mb-4">

                <div class="card text-center shadow-lg h-100 border-warning">

                    <div class="card-body d-flex flex-column justify-content-center">

                        <!-- Ikon -->
                        <i class="bi bi-graph-up
                                      display-1
                                      text-warning
                                      mb-3"></i>

                        <!-- Titel -->
                        <h3 class="card-title">
                            Årsopgørelser
                        </h3>

                        <!-- Beskrivelse -->
                        <p class="card-text">
                            Se årsopgørelser for hvert år.
                        </p>

                        <!-- Knap -->
                        <a asp-controller="YearSummaries"
                           asp-action="Index"
                           class="btn btn-warning mt-auto">

                            Se Årsopgørelser
                        </a>

                    </div>
                </div>
            </div>

            <!-- Produktkatalog -->
            <div class="col-md-3 mb-4">

                <div class="card text-center shadow-lg h-100 border-info">

                    <div class="card-body d-flex flex-column justify-content-center">

                        <!-- Ikon -->
                        <i class="bi bi-box-seam
                                      display-1
                                      text-info
                                      mb-3"></i>

                        <!-- Titel -->
                        <h3 class="card-title">
                            Produktkatalog
                        </h3>

                        <!-- Beskrivelse -->
                        <p class="card-text">
                            Se og rediger dine produkter.
                        </p>

                        <!-- Knap -->
                        <a asp-controller="Products"
                           asp-action="Index"
                           class="btn btn-info mt-auto">

                            Gå til Produktkatalog
                        </a>

                    </div>
                </div>
            </div>
        }

    </div>
</div>

