@model IEnumerable<AdminPanel.Models.YearSummary>

@{
    ViewData["Title"] = "Årsopgørelser";
}

<h2>Årsopgørelser</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>År</th>
            <th>Omsætning</th>
            <th>Udgifter</th>
            <th>Antal Jobs</th>
            <th>Årsopgørelse</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Year</td>
                <td>@item.Revenue.ToString("C")</td>
                <td>@item.Expenses.ToString("C")</td>
                <td>@item.NumberOfJobs</td>
                <td>@item.YearSummaries.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>